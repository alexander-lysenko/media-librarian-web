{
  "name": "alexander-lysenko/media-librarian-web",
  "type": "project",
  "description": "Media Librarian (WEB)",
  "version": "0.0.0",
  "keywords": [],
  "license": "none",
  "require": {
    "php": "^8.2",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-sqlite3": "*",
    "darkaonline/l5-swagger": "^11.1",
    "guzzlehttp/guzzle": "^7.15",
    "laravel/framework": "^12.60",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.35",
    "unsplash/unsplash": "^3.2"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.5",
    "phpunit/phpunit": "^11.5",
    "spatie/laravel-ignition": "^2.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan l5-swagger:generate --ansi",
      "@php artisan route:clear --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
